---
import AmazoniaLayout    from "../layouts/AmazoniaLayout.astro";
import Navbar            from "../components/Navbar.astro";
import Hero              from "../components/Hero.astro";
import SearchBar         from "../components/SearchBar.astro";
import Categories        from "../components/Categories.astro";
import FeaturedProducts  from "../components/FeaturedProducts.astro";
import Departments       from "../components/Departments.astro";
import PromoBanner       from "../components/PromoBanner.astro";
import Benefits          from "../components/Benefits.astro";
import Testimonials      from "../components/Testimonials.astro";
import AppSection        from "../components/AppSection.astro";
import Newsletter        from "../components/Newsletter.astro";
import Footer            from "../components/Footer.astro";
---

<AmazoniaLayout title="Inicio">
  <Navbar />
  <Hero />
  <SearchBar />
  <Categories />
  <FeaturedProducts />
  <Departments />
  <PromoBanner />
  <Benefits />
  <Testimonials />
  <AppSection />
  <Newsletter />
  <Footer showDecor={false} />
</AmazoniaLayout>
