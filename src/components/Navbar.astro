---
---
<nav class="am-navbar" id="amNavbar">
  <a href="/" class="am-nav-logo">
    <img src="/logo-blanco.svg" alt="Amazonia Market" class="am-nav-logo-img" />
  </a>
  <ul class="am-nav-links">
    <li><a href="/#categorias">Categorías</a></li>
    <li><a href="/#productos">Productos</a></li>
    <li><a href="/#departamentos">Nuestras tiendas</a></li>
    <li><a href="/contacto">Contacto</a></li>
  </ul>
  <div class="am-hamburger" id="amHamburger">
    <span></span><span></span><span></span>
  </div>
</nav>

<div class="am-mobile-menu" id="amMobileMenu">
  <a href="/#categorias">Categorías</a>
  <a href="/#productos">Productos</a>
  <a href="/#departamentos">Nuestras tiendas</a>
  <a href="/contacto">Contacto</a>
</div>

<script>
  const navbar = document.getElementById('amNavbar');
  window.addEventListener('scroll', () => navbar?.classList.toggle('scrolled', window.scrollY > 60));

  const menu = document.getElementById('amMobileMenu');
  document.getElementById('amHamburger')?.addEventListener('click', () => menu?.classList.toggle('open'));
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => menu.classList.remove('open')));
</script>
